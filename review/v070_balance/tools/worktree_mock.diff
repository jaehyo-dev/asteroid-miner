@@ -363,6 +363,9 @@ func _apply_layout() -> void:
 		if state != State.REVEAL:
 			cards[i].settle()
 	_build_button(lay, top + int(lay["h"]) + int(lay["btn_gap"]), int(view.x))
+	var mock := OS.get_environment("SKIP_MOCK")
+	if mock != "":
+		_mock_skip(mock, lay, top, x0, w, gap, int(view.x))
 
 
 ## 다시 뽑기 버튼: 판 그림 + "다시 뽑기 N회". 0회면 어둡게 꺼진다
@@ -408,3 +411,62 @@ func _button_label(text: String, pos: Vector2, font_size: int, color: Color) ->
 	label.add_theme_font_size_override("font_size", font_size)
 	label.add_theme_color_override("font_color", color)
 	reroll_button.add_child(label)
+
+
+## 시안: 건너뛰기 버튼 (A = 다시 뽑기 옆, B = 카드 오른쪽 세로 칸)
+var _skip_btn: Control
+func _mock_skip(mode: String, lay: Dictionary, top: int, x0: int, w: int, gap: int, view_w: int) -> void:
+	if _skip_btn != null:
+		_skip_btn.queue_free()
+	var btn: Vector2i = lay["btn"]
+	var font_size: int = lay["btn_size"]
+	var b := Control.new()
+	var plate := NinePatchRect.new()
+	var art := LevelCard.tex("button")
+	plate.texture = art
+	plate.patch_margin_left = art.get_width() / 2
+	plate.patch_margin_right = art.get_width() / 2
+	plate.patch_margin_top = art.get_height() / 2
+	plate.patch_margin_bottom = art.get_height() / 2
+	b.add_child(plate)
+	var text := "건너뛰기"
+	var sub := "광물 +40"
+	if mode == "A":
+		var half := gap / 2 + 2
+		var small := Vector2i(btn.x, btn.y)
+		reroll_button.position.x = view_w / 2 - half - small.x
+		b.position = Vector2(view_w / 2 + half, reroll_button.position.y)
+		b.size = small
+	else:
+		var bw := maxi(w / 3, font_size * 3)
+		b.position = Vector2(x0 + cards.size() * (w + gap), top + int(lay["h"]) / 2 - int(lay["h"]) / 4)
+		b.size = Vector2(bw, int(lay["h"]) / 2)
+	plate.size = b.size
+	var font := LevelCard.FONT
+	var line_h := int(font.get_height(font_size))
+	if mode == "A":
+		var tw := int(font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x)
+		var sw := int(font.get_string_size(sub, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x)
+		if tw + font_size / 2 + sw > int(b.size.x) - font_size * 2:  # 좁으면(폰) "광물" 글자를 뺀다
+			sub = "+40"
+			sw = int(font.get_string_size(sub, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x)
+		var x := (int(b.size.x) - tw - font_size / 2 - sw) / 2
+		_mock_label(b, text, Vector2(x, (int(b.size.y) - line_h) / 2), font_size, LABEL_INK)
+		_mock_label(b, sub, Vector2(x + tw + font_size / 2, (int(b.size.y) - line_h) / 2), font_size, COUNT_COLOR)
+	else:
+		var y := int(b.size.y) / 2 - line_h
+		for t in [[text, LABEL_INK], [sub, COUNT_COLOR]]:
+			var tw := int(font.get_string_size(t[0], HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x)
+			_mock_label(b, t[0], Vector2((int(b.size.x) - tw) / 2, y), font_size, t[1])
+			y += line_h
+	add_child(b)
+	_skip_btn = b
+
+
+func _mock_label(parent: Control, text: String, pos: Vector2, font_size: int, color: Color) -> void:
+	var label := Label.new()
+	label.text = text
+	label.position = pos
+	label.add_theme_font_size_override("font_size", font_size)
+	label.add_theme_color_override("font_color", color)
+	parent.add_child(label)
