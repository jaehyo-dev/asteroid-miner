@@ -169,6 +171,17 @@ func play(sound_name: String, pitch_jitter: float = -1.0, pitch: float = 1.0, db
 	return false
 
 
+## 이름이 prefix로 시작하는 소리가 지금 몇 개 나는지 (시안)
+func voices_playing(prefix: String) -> int:
+	var n := 0
+	for k in _pools:
+		if str(k).begins_with(prefix):
+			for player: AudioStreamPlayer in _pools[k]:
+				if player.playing:
+					n += 1
+	return n
+
+
 ## 소리 이름의 재생기 묶음 (테스트용)
 func pool(sound_name: String) -> Array:
 	return _pools[sound_name]
